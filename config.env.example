# 华仔 AutoJs 工具箱 · AI 能力包 —— MCP 用户级配置（config.env.example）
#
# 这是「唯一」需要维护的配置文件。不要改插件目录里的 .mcp.json，那里的键不会再放可调参数。
# 本文件生效后放在：
#   Windows      %USERPROFILE%\.hz-autojs-mcp\config.env
#   macOS/Linux  $HOME/.hz-autojs-mcp/config.env
#   自定义位置   设置环境变量 HZ_MCP_CONFIG_FILE 指向你的文件
#
# 三条规则：
#   1. 取值优先级：进程环境变量 > 本文件 > 代码内置默认值；
#   2. 空值（写 KEY= 不写内容）表示"未设置"，继续用代码默认值；
#   3. 布尔值只认 1 / true / yes / on（不区分大小写），其它一律按 false。
#
# 改完必须新开一个任务会话：MCP 进程只在启动时读一次本文件。
#
# 常用命令（在插件根目录执行）：
#   node mcp/tools/mcp-config.mjs path    查看本机解析到的配置路径
#   node mcp/tools/mcp-config.mjs init    首次创建配置文件（已存在则原样保留）
#   node mcp/tools/mcp-config.mjs sync    插件升级后补齐新增参数（不会动你已有的值）
#   node mcp/tools/mcp-config.mjs show    脱敏查看当前生效值，以及每个键来自哪一层

# ============================== 一、连接 V5 ==============================

# V5 服务端地址。MCP 的所有 API 请求都发到这里。
HZ_V5_BASE_URL=http://127.0.0.1:9999

# 返回给你的「确认页 / 设备授权页」链接使用的外部地址。
# V5 与 Codex 在同一台机器时留空即可。只有"MCP 访问 V5 的地址"和"你的浏览器能打开的地址"
# 不是同一个时才填，例如 MCP 走 http://127.0.0.1:9999、浏览器要走 http://192.168.1.50:9999。
# 它不影响 API 请求、授权和权限判定。
HZ_V5_PUBLIC_URL=

# V5 服务访问令牌：V5 界面「系统设置 > 访问安全 > V5 服务级 MCP Token」点"显示/复制"拿到。
# 只有在 V5 开启「Web 登录保护」后才需要填；关闭时 V5 不校验该令牌，留空即可。
# 这是敏感值，不要写进项目仓库或粘贴到聊天里。
HZ_V5_AUTH_TOKEN=

# 写入 V5 授权与审计记录的来源标识，只作审计来源，不参与权限判定。
# 默认 hz-autojs-device-mcp；项目 MCP 由插件自己的 .mcp.json 固定为 hz-autojs-project-mcp。
HZ_MCP_CLIENT_ID=hz-autojs-device-mcp

# 项目同步基线目录（项目 MCP 用）。留空 = 默认 <用户主目录>/.hz-autojs-mcp/state。
# 保持默认，同步基线就不会随插件升级丢失。
HZ_MCP_STATE_DIR=

# ============================== 二、安全门禁 ==============================

# 只读模式。true = 拦截所有操作类工具（点击 / 滑动 / 输入 / 脚本下发 / 设备文件写入 / 打包 / APK 安装），
# 返回 READ_ONLY 且请求不会发到 V5；列表、状态、截图、布局、OCR、日志等观察类工具不受影响。
HZ_MCP_READ_ONLY=false

# 危险动作总开关。false = 一律返回 DANGEROUS_ACTION_DISABLED，动作不下发到设备。
# true = 按客户端审批模式处理：完全访问自动放行；需要审批时弹确认卡；客户端无法确认时拒绝。
HZ_MCP_ENABLE_DANGEROUS_ACTIONS=true

# 设备锁。true = 同一台设备同时只允许一个操作在跑，重复调用返回「设备 X 正在执行 Y」。
HZ_MCP_ENABLE_DEVICE_LOCK=true

# 作者工具（教程录制）MCP 工具开关：默认 false，只暴露 tutorial_authoring_status；
# 设为 true 后 hz-autojs-authoring-mcp 暴露 tutorial_session_* / tutorial_mobile_* / tutorial_desktop_step 等录制工具。
HZ_MCP_ENABLE_TUTORIAL_TOOLS=false

# 直控通道开关。当前版本尚未接线：会被读取但没有任何行为，保留键位。
HZ_MCP_USE_DIRECT_CONTROL=false

# ============================== 三、传输（一般不用改） ==============================

# stdio / http / both。AI 客户端拉起本地进程用 stdio；写成其它值会导致 MCP 启动失败。
HZ_MCP_TRANSPORT=stdio

# HTTP 监听地址。监听非回环地址且未设置 HZ_MCP_HTTP_AUTH_TOKEN 时只打警告，不阻断。
HZ_MCP_HTTP_HOST=127.0.0.1

# HTTP 监听端口。both 模式下端口被占用会降级为 stdio 并打警告；单用 http 时直接启动失败。
HZ_MCP_HTTP_PORT=3333

# HTTP 端点路径。路径不匹配返回 404。
HZ_MCP_HTTP_PATH=/mcp

# MCP HTTP 入站令牌：只保护入站端点，不转发给 V5。为空表示不校验。
HZ_MCP_HTTP_AUTH_TOKEN=

# HTTP 传输是否返回 JSON 响应。false = 使用 SSE 流。
HZ_MCP_HTTP_JSON_RESPONSE=false

# HTTP 会话空闲回收时间（毫秒），允许区间 60000 - 86400000。
HZ_MCP_HTTP_SESSION_IDLE_MS=1800000

# ============================== 四、超时 ==============================

# 单次访问 V5 的普通请求（JSON 接口）超时（毫秒），允许区间 1000 - 120000；上传类请求改用下面的独立预算。
HZ_MCP_REQUEST_TIMEOUT_MS=15000

# 上传类请求（整文件或单个分片）的单次超时（毫秒），允许区间 5000 - 3600000，不套用普通请求上限。
HZ_MCP_UPLOAD_REQUEST_TIMEOUT_MS=600000

# 分片上传的单片大小（字节），允许区间 1048576 - 33554432。
HZ_MCP_UPLOAD_CHUNK_BYTES=8388608

# 超过该大小的文件改用分片/断点续传上传（字节），允许区间 1048576 - 1073741824。
HZ_MCP_UPLOAD_RESUMABLE_THRESHOLD_BYTES=16777216

# 单个分片上传失败后的最大重试次数，允许区间 0 - 10。
HZ_MCP_UPLOAD_RETRY_COUNT=3

# 等待任务进入终态的默认超时（毫秒），允许区间 1000 - 600000；调用参数 timeoutMs 可单次覆盖。
HZ_MCP_TASK_WAIT_TIMEOUT_MS=30000

# 等待任务时的轮询间隔（毫秒），允许区间 200 - 10000。
HZ_MCP_TASK_POLL_INTERVAL_MS=1000

# ============================== 五、待确认动作 ==============================

# 是否就地向 AI 客户端弹确认卡。false = 需要确认的动作一律转到 V5 确认页处理。
HZ_MCP_ENABLE_ELICITATION=true

# 低于该耗时的 decline 视为客户端预授权（你没有看到确认框），而不是你点了拒绝。
HZ_MCP_ELICITATION_AUTO_DECLINE_MS=1000

# 预授权场景是否自动向 V5 确认执行。false = 退回 V5 确认页等人工确认。
HZ_MCP_AUTO_APPROVE_ON_PREAUTHORIZATION=true

# ============================== 六、审计 ==============================

# 审计日志（JSONL）。留空 = 不落文件。
# 写入前会把键名含 password / token / secret 的字段替换为 ***。
HZ_MCP_AUDIT_LOG_PATH=
