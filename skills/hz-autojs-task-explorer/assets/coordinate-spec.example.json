  "guards": {
    "forbiddenTexts": ["购买", "充值", "战令"],
    "guardedActions": [
      { "text": "快速修炼", "rule": "仅每日首次免费可用；出现 50 紫晶卡消耗时必须停止并记录" },
      { "text": "捐献", "rule": "只使用每日免费次数（档位消耗为 0）；超出后消耗紫晶卡，一律跳过", "readingKey": "freeDonateLeft" },
      { "text": "凝练", "rule": "先读势力贡献，≥1700 才执行一次，不连续点击", "readingKey": "factionContribution" },
      { "text": "扫荡", "rule": "只走每日免费次数；收费档（20 紫晶卡/次）跳过", "readingKey": "freeSweepLeft" }
    ],
    "note": "forbiddenTexts 出现即跳过；guardedActions 必须先读面板数值再决定是否执行，读完不足就停在原状态"
  },
